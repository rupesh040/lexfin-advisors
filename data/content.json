            "items": [
              {
                "question": "What legal services do you offer?",
                "answer": "We offer a wide range of legal services, including corporate law, civil litigation, family law, real estate, and legal consultation for individuals and businesses."
              },
              {
                "question": "How can I schedule a consultation?",
                "answer": "You can schedule a consultation by clicking the 'Contact Us' button, filling out our quick contact form, or calling our direct office line to book a dedicated session with our senior attorneys."
              },
              {
                "question": "Do you provide legal support for businesses?",
                "answer": "Yes, we specialize in comprehensive business law support, from entity incorporation and regulatory compliance to contract drafting, tax structuring, and commercial dispute resolution."
              },
              {
                "question": "How much do your legal services cost?",
                "answer": "Our fee structures are transparent and tailored to your specific matter, offering competitive hourly rates, capped milestone billing, and retainer arrangements with no hidden fees."
              },
              {
                "question": "Can you handle cases outside my city or state?",
                "answer": "Yes, our multi-jurisdictional network of licensed attorneys and partner counsels enables us to represent clients across national and cross-border jurisdictions seamlessly."
              }
            ]
          }
        }
